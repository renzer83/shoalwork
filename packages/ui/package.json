{
  "name": "@shoalwork/ui",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "test": "vitest run",
    "build": "tsc && node -e \"require('node:fs').cpSync('src/assets','dist/assets',{recursive:true})\""
  },
  "dependencies": {
    "@shoalwork/api-client": "workspace:*",
    "@dagrejs/dagre": "3.1.1",
    "@shoalwork/contracts": "workspace:*",
    "effect": "catalog:",
    "expo-secure-store": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-paper": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-svg": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "jsdom": "30.1.3",
    "react-dom": "catalog:",
    "react-native-web": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
