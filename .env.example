# Copy to .env (gitignored) and fill in. Never commit real values.
DATABASE_PATH=./data/shoalwork.db
API_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_FORUM_CHAT_ID=
OLLAMA_URL=
OLLAMA_EMBED_MODEL=
REFLEX_CONFIG_PATH=
REFLEX_URL=
REFLEX_TOKEN=
TANK_ROOT=
TANK_SUDO=false
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=
LOG_LEVEL=
BUDGET_BOT_WINDOW_HOURS=24
# Steps of one plan level that run at once (blank: 3).
PLAN_CONCURRENCY=
# Agent messages a task may carry before handoffs are refused (blank: 20; a whole number of at least 1).
MAX_AGENT_MSGS_PER_TASK=
APPROVAL_TTL_MINUTES=
# Origin the Bot's reef MCP server calls (blank: http://127.0.0.1:PORT).
APP_URL=
# Built entrypoint of the reef MCP server (blank: packages/reef/dist/mcp.js).
REEF_MCP_ENTRY=
# Permission bridge for claude-code runs (true or false; blank: false). Needs a built packages/executors.
PERMISSION_BRIDGE=
# Built entrypoint of the bridge server (blank: packages/executors/dist/permission-bridge/index.js).
PERMISSION_BRIDGE_ENTRY=
# Policy files (blank: config/policies).
POLICY_DIR=
# Briefing context budgets (a blank value would point at the repo root, so it keeps the default path).
CONTEXT_CONFIG_PATH=config/context.yaml
# Subscription quota windows per executor (T-075); the one source of quota numbers.
QUOTAS_CONFIG_PATH=config/quotas.yaml
# Executor instances (T-080). Blank: config/executors.yaml.
EXECUTORS_CONFIG_PATH=config/executors.yaml
# Read by claude-code@zai only (ADR-011). Blank: that instance is listed as unavailable.
ZAI_API_KEY=
# Vault (T-064): the encrypted file backend and its key. VAULT_KEY also seals the OAuth tokens of remote MCP servers (T-185).
VAULT_FILE=
VAULT_KEY=
# Voice service (T-103/T-104). Blank values take the defaults noted here.
# Sidecar URLs: when set, the sidecar is used as is and not spawned (defaults: http://127.0.0.1:28921 STT, :28922 TTS).
VOICE_STT_URL=
VOICE_TTS_URL=
# whisper.cpp (blank: ~/.app/voice/whisper.cpp/build/bin/whisper-server and models/ggml-large-v3-turbo.bin).
WHISPER_BIN=
WHISPER_MODEL=
# Kokoro model directory (blank: ~/.app/voice/kokoro).
KOKORO_DIR=
# Host folders mounted by services/voice/docker-compose.voice.yml (required only for the compose setup).
WHISPER_MODELS_DIR=
KOKORO_MODELS_DIR=
# Language of the spoken replies: pt, en or es (blank: pt).
VOICE_LANG_DEFAULT=
# Audio input/output via sox. AUDIODEV picks the input device (blank: system default); AUDIODRIVER is passed through.
AUDIODEV=
AUDIODRIVER=
# Silero VAD model (blank: ~/.app/voice/silero/silero_vad.onnx).
SILERO_MODEL=
# VAD and utterance segmentation. Blank: threshold 0.5 (0-1), speech 250 ms, silence 700 ms, pad 200 ms, max 30000 ms.
VOICE_VAD_THRESHOLD=
VOICE_MIN_SPEECH_MS=
VOICE_MIN_SILENCE_MS=
VOICE_PAD_MS=
VOICE_MAX_UTTERANCE_MS=
